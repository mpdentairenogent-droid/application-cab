# Copier ce fichier en .env (développement) et renseigner des valeurs réelles.
# Ne jamais committer le fichier .env : il est ignoré par git (.gitignore).

# --- Base de données ---
# Correspond aux identifiants définis dans docker-compose.yml pour le service "postgres".
DATABASE_URL="postgresql://auto_ecoles:auto_ecoles_dev_password@localhost:5432/auto_ecoles?schema=public"

# --- Authentification (Auth.js) ---
# Générer une valeur aléatoire forte, par exemple : openssl rand -base64 32
AUTH_SECRET="a-remplacer-par-une-valeur-aleatoire-forte"
# URL publique de l'application (utilisée pour les callbacks et liens absolus)
AUTH_URL="http://localhost:3000"

# --- Stockage documents (S3-compatible, MinIO en local) ---
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_REGION="eu-west-3"
STORAGE_ACCESS_KEY_ID="auto_ecoles_admin"
STORAGE_SECRET_ACCESS_KEY="auto_ecoles_dev_password"
STORAGE_BUCKET="documents-auto-ecoles"
# true en local (MinIO), false face à un vrai S3/R2 en production
STORAGE_FORCE_PATH_STYLE="true"

# --- Divers ---
# Fuseau horaire applicatif (affichage des dates/heures)
APP_TIMEZONE="Europe/Paris"
# Environnement : development | test | production
NODE_ENV="development"

# --- Comptes de démonstration (script prisma/seed.ts) ---
# Ne jamais activer en production réelle. Mot de passe commun à tous les comptes de démo.
SEED_DEMO_ACCOUNTS="true"
SEED_DEMO_PASSWORD="Demo1234!"
# Doit rester absent/false partout sauf sur un déploiement de démonstration explicite
# (voir "Déploiement de démonstration" dans le README) : autorise le seed à s'exécuter
# même si NODE_ENV=production. Ne jamais activer sur un environnement réel.
ALLOW_DEMO_SEED_IN_PRODUCTION="false"
