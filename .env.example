# Copie ce fichier en ".env.local" (ignoré par git) et renseigne les valeurs
# de ton projet Supabase (Project Settings > API).
#
# EXPO_PUBLIC_* est le seul préfixe qu'Expo expose au code client — ne jamais
# y mettre une clé secrète (service_role, etc.), uniquement l'URL et la clé
# "anon" publique (protégée par les policies RLS côté base).

EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Secret — jamais préfixé EXPO_PUBLIC_, jamais dans l'app mobile. Utilisée
# uniquement par scripts/seed-demo.ts (Node, en local) pour créer les comptes
# de démonstration via l'API Admin. Project Settings > API > service_role.
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
