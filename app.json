{
  "expo": {
    "name": "cabinet-dentaire-app",
    "slug": "cabinet-dentaire-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cabinetdentaireapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.mpdentairenogent.app"
    },
    "android": {
      "package": "com.mpdentairenogent.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "Utilisée pour scanner les QR codes des équipements et prendre des photos (stock, contrôles)."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Utilisée pour choisir une photo depuis la galerie (stock, contrôles).",
          "cameraPermission": "Utilisée pour scanner les QR codes des équipements et prendre des photos (stock, contrôles)."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Utilisé pour déverrouiller l'application rapidement et en sécurité."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#208AEF"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "eb840e2d-0ea8-4308-b8ac-a81c96a34a31"
      }
    },
    "owner": "mpkamcams-team"
  }
}
